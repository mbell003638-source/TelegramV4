# Copy this file to keystore.properties in this same directory and fill in
# the empty fields. keystore.properties is gitignored; never commit the copy.
# Paths are resolved from the android/ Gradle root (the parent of signing/).

# Keystore file, relative to android/. Forward slashes work on Windows.
storeFile=signing/agentos-release.jks

# Password that unlocks the keystore file itself.
storePassword=

# Alias of the key inside the keystore. Must match the -alias passed to keytool.
keyAlias=agentos

# Password that unlocks the key identified by keyAlias. May match storePassword.
keyPassword=
