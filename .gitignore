# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment & Secrets (NEVER COMMIT SECRETS)
.env
.env.local
.env.*.local

# Logs and Process State
*.log
*.pid
bridge.pid
crash.log
bot.log
guard.log

# Database State & WAL
store/*.db
store/*.db-wal
store/*.db-shm
!store/.gitkeep

# Isolated Workspaces & Output Logs
workspaces/task_*
workspaces/outputs/*.log
!workspaces/.gitkeep

# Uploads
uploads/*
!uploads/.gitkeep

# Session Backups & Local Caches
sessions/*.bak
sessions/*.json
!sessions/schema.json
sessions/shell-jobs/*
!sessions/shell-jobs/.gitkeep
!sessions/.gitkeep

# Satellite Local Config
satellite/config.json

# OS Artifacts
.DS_Store
Thumbs.db
