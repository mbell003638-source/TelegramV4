# =============================================================================
#  ClaudeClaw Assistant Configuration (.env)
# =============================================================================

# Telegram Bot (Optional — leave blank to run in Standalone Mission Control Web mode)
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_ID=

# Mission Control Dashboard (Web UI on localhost:3141)
DASHBOARD_PORT=3141
DASHBOARD_TOKEN=admin

# Dynamic Concurrency Pool
MAX_CONCURRENT_AGENTS=4

# Singleton TCP Lock Port
BRIDGE_LOCK_PORT=47200
BRIDGE_LOCK_HOST=127.0.0.1

# Satellite Hub Key (for remote Windows worker authentication)
SATELLITE_KEY=admin

# Workspace Root
WORKSPACE_ROOT=./workspaces

# =============================================================================
#  Next.js WebUI (webui/) Configuration
# =============================================================================

# Origin the WebUI uses to reach the bridge/dashboard server above.
# NEXT_PUBLIC_ vars are inlined into the browser bundle at build time, so this
# must be the address a *client's browser* can actually reach — not just the
# server. When deploying to a VPS, set this to the VPS's public origin
# (e.g. http://your-vps-domain-or-ip:3141) so phones and other devices on the
# internet can reach the bridge; localhost only works when browser and bridge
# are on the same machine.
NEXT_PUBLIC_BRIDGE_URL=http://localhost:3141

# Must match DASHBOARD_TOKEN above — sent as the ?token= query param on every
# WebUI -> bridge request.
NEXT_PUBLIC_BRIDGE_TOKEN=admin

# Absolute path to the Obsidian vault the WebUI reads/writes chats, goals, and
# journal entries into. Leave blank to default to
# <current user's home directory>/Documents/ObsidianVault.
OBSIDIAN_VAULT_PATH=
