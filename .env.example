# =============================================================================
#  ClaudeClaw Assistant Configuration (.env)
# =============================================================================

# Telegram Bot (Optional — leave blank to run in Standalone Mission Control Web mode)
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_ID=

# Mission Control Dashboard (Web UI on localhost:3141)
DASHBOARD_PORT=3141
DASHBOARD_TOKEN=admin

# Dynamic Concurrency Pool
MAX_CONCURRENT_AGENTS=4

# Singleton TCP Lock Port
BRIDGE_LOCK_PORT=47200
BRIDGE_LOCK_HOST=127.0.0.1

# Satellite Hub Key (for remote Windows worker authentication)
SATELLITE_KEY=admin

# Workspace Root
WORKSPACE_ROOT=./workspaces

# =============================================================================
#  Next.js WebUI (webui/) Configuration
# =============================================================================

# Origin the WebUI uses to reach the bridge/dashboard server above.
# NEXT_PUBLIC_ vars are inlined into the browser bundle at build time, so this
# must be the address a *client's browser* can actually reach — not just the
# server. When deploying to a VPS, set this to the VPS's public origin
# (e.g. http://your-vps-domain-or-ip:3141) so phones and other devices on the
# internet can reach the bridge; localhost only works when browser and bridge
# are on the same machine.
NEXT_PUBLIC_BRIDGE_URL=http://localhost:3141

# Must match DASHBOARD_TOKEN above — sent as the ?token= query param on every
# WebUI -> bridge request.
NEXT_PUBLIC_BRIDGE_TOKEN=admin

# Absolute path to the Obsidian vault the WebUI reads/writes chats, goals, and
# journal entries into. Leave blank to default to
# <current user's home directory>/Documents/ObsidianVault.
OBSIDIAN_VAULT_PATH=

# =============================================================================
#  OmniRouter — one key in front of every provider
# =============================================================================

# The single master key that fronts every provider below. Any OpenAI-compatible
# tool can point at http://localhost:3141/v1 with this key and reach all of
# them. Leave blank and one is generated at boot; read it back from
# GET /api/router/key (or the startup log).
OMNIROUTER_KEY=

# How a request picks among providers that can serve the model:
#   priority (default) | round-robin | least-used | weighted
OMNIROUTER_STRATEGY=priority

# Sent to OpenRouter as HTTP-Referer / X-Title for attribution. Optional.
OMNIROUTER_APP_URL=
OMNIROUTER_APP_TITLE=

# --- Upstream provider keys -------------------------------------------------
# Every provider is OPTIONAL. The eight CLI agents run on your existing
# subscriptions and need none of these; keys only widen what the router can
# reach. A provider with no key stays disabled. Multiple keys for one provider
# can be comma-separated, and the router will rotate across the pool.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
GROQ_API_KEY=
GEMINI_API_KEY=
MOONSHOT_API_KEY=
XAI_API_KEY=

# Local models (Ollama / LM Studio / vLLM). Needs no key.
OLLAMA_BASE_URL=http://localhost:11434/v1

# =============================================================================
#  WhatsApp (Meta Cloud API) — optional second chat channel
# =============================================================================
# Full setup guide: docs/WHATSAPP.md. Leave blank to run Telegram-only.

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Signs inbound webhooks. Without it, unsigned payloads are ACCEPTED with a
# warning — set this in production or anyone who finds the URL can talk to
# your agents.
WHATSAPP_APP_SECRET=

# Comma-separated allow-list of numbers permitted to use the bot.
# An EMPTY value means anyone can, mirroring a Telegram bot with no
# ALLOWED_USER_ID. Set it.
WHATSAPP_ALLOWED_NUMBERS=

WHATSAPP_WEBHOOK_PATH=/webhook/whatsapp
WHATSAPP_API_VERSION=v21.0
DISABLE_WHATSAPP=false

# =============================================================================
#  Syncthing — replicate the shared brain between machines
# =============================================================================
# Keeps the Obsidian vault, memory store and workspaces identical across
# setups, peer to peer with no cloud. Point this at a Syncthing you already
# run. If the key is blank, it is auto-discovered from a local Syncthing
# config.xml; sync features simply stay off if neither is found.

SYNCTHING_URL=http://127.0.0.1:8384
SYNCTHING_API_KEY=

# =============================================================================
#  Task planner & self-improvement
# =============================================================================

# Model used to decompose a request into a task graph. Defaults to a routed
# model when blank.
TASK_PLANNER_MODEL=
OMNIROUTER_PLANNER_MODEL=
TASK_PLANNER_AGENT_TIMEOUT_MS=600000

# Lifts the GitHub API rate limit when the upstream update watcher checks the
# reference projects that have no local clone. Needs no scopes — public repo
# reads only. Optional.
GITHUB_TOKEN=

# =============================================================================
#  Meetings (optional providers)
# =============================================================================
# With none of these set, meeting dispatch falls back to a MiroTalk P2P room,
# which needs no account.
DAILY_API_KEY=
RECALL_API_KEY=
PIKA_API_KEY=

# =============================================================================
#  Advanced / operational
# =============================================================================

# Kill switches. Each gates a dangerous boundary and is hot-reloaded from this
# file, so flipping one takes effect without a restart.
LLM_SPAWN_ENABLED=true
WARROOM_TEXT_ENABLED=true
WARROOM_VOICE_ENABLED=true
DASHBOARD_MUTATIONS_ENABLED=true
MISSION_AUTO_ASSIGN_ENABLED=true
SCHEDULER_ENABLED=true

# Run the web HUD without the Telegram gateway.
DISABLE_TELEGRAM=false

# Permit a second instance for the web HUD (normally blocked by a port lock).
ALLOW_CONCURRENT_HUD=false

# SQLite path. Relative paths resolve against the project root.
DB_PATH=

# Logging
BRIDGE_LOG_FILE=
BRIDGE_LOG_MAX_BYTES=5000000
BRIDGE_LOG_BACKUPS=5
