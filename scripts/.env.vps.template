# =============================================================================
#  ClaudeClaw Master Environment — 32 GB RAM Cloud VPS
# =============================================================================

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
ALLOWED_USER_ID=YOUR_TELEGRAM_NUMERIC_ID

# Concurrency & Swarm Resource Management (32 GB RAM Tuning)
# Default 4 concurrent heavy CLI agents (Claude/Codex/Grok ~3-5GB RAM each)
# Can be changed dynamically at runtime via Telegram: /concurrency <N>
MAX_CONCURRENT_AGENTS=4

# Mission Control Dashboard
DASHBOARD_PORT=3141
DASHBOARD_TOKEN=YOUR_STRONG_SECRET_TOKEN

# Distributed Satellite Worker Key (Used by Windows worker to authenticate)
SATELLITE_KEY=YOUR_STRONG_SECRET_TOKEN

# Singleton Process Lock Port
BRIDGE_LOCK_PORT=47200
BRIDGE_LOCK_HOST=127.0.0.1

# Workspace Root
WORKSPACE_ROOT=/opt/claudeclaw/workspaces
